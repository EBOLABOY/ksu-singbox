# Hotspot/tethering downstream interfaces only (explicitly excludes STA uplink wlan0).
ap_list=("wlan1" "wlan2" "wlan3" "softap+" "swlan+" "ap+" "rndis+" "ncm+" "usb+" "bt-pan")
ignore_out_list=()
