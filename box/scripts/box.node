#!/system/bin/sh

CONFIG_PATH="/data/adb/box/sing-box/config.json"
BIN_PATH="/data/adb/box/bin/sing-box"
SERVICE_SCRIPT="/data/adb/box/scripts/box.service"

case "$1" in
  get)
    if [ -f "$CONFIG_PATH" ]; then
      cat "$CONFIG_PATH"
    else
      echo "{}"
    fi
    ;;

  save)
    if [ -z "$2" ]; then
      echo "Error: missing base64 config payload"
      exit 1
    fi
    TMP_CONFIG="/data/adb/box/sing-box/config.json.tmp"
    echo "$2" | /data/adb/ksu/bin/busybox base64 -d > "$TMP_CONFIG"
    if [ $? -ne 0 ] || [ ! -s "$TMP_CONFIG" ]; then
      echo "Error: failed to decode base64 payload"
      rm -f "$TMP_CONFIG"
      exit 1
    fi

    # Verify configuration with sing-box check
    CHECK_OUTPUT=$("$BIN_PATH" check -D /data/adb/box/sing-box -c "$TMP_CONFIG" 2>&1)
    if [ $? -ne 0 ]; then
      echo "Check failed: $CHECK_OUTPUT"
      rm -f "$TMP_CONFIG"
      exit 1
    fi

    # Backup & replace
    cp -f "$CONFIG_PATH" "${CONFIG_PATH}.bak"
    mv -f "$TMP_CONFIG" "$CONFIG_PATH"
    chmod 644 "$CONFIG_PATH"

    # Restart service in background
    "$SERVICE_SCRIPT" restart >/dev/null 2>&1 &
    echo "OK"
    ;;

  restart)
    "$SERVICE_SCRIPT" restart >/dev/null 2>&1 &
    echo "OK"
    ;;

  add)
    if [ -z "$2" ]; then
      echo "Error: missing node JSON payload"
      exit 1
    fi
    PAYLOAD="$2"
    if ! echo "$PAYLOAD" | grep -q '^{'; then
      PAYLOAD=$(echo "$PAYLOAD" | /data/adb/ksu/bin/busybox base64 -d 2>/dev/null)
    fi
    TAG=$(echo "$PAYLOAD" | grep -o '"tag"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed 's/.*:[[:space:]]*"//;s/"$//')
    if [ -z "$TAG" ]; then
      echo "Error: cannot parse tag from payload"
      exit 1
    fi
    TMP_CONFIG="/data/adb/box/sing-box/config.json.tmp"
    /data/adb/ksu/bin/busybox awk -v payload="$PAYLOAD" -v tag="$TAG" '
      BEGIN { in_proxy=0; added_to_proxy=0; added_node=0 }
      /"tag"[[:space:]]*:[[:space:]]*"PROXY"/ { in_proxy=1 }
      in_proxy && /"outbounds"[[:space:]]*:[[:space:]]*\[/ {
        print
        print "        \"" tag "\","
        added_to_proxy=1
        next
      }
      in_proxy && /^[[:space:]]*\}/ { in_proxy=0 }
      /"type"[[:space:]]*:[[:space:]]*"(direct|block)"/ && !added_node {
        print "    " payload ","
        added_node=1
      }
      { print }
    ' "$CONFIG_PATH" > "$TMP_CONFIG"

    CHECK_OUTPUT=$("$BIN_PATH" check -D /data/adb/box/sing-box -c "$TMP_CONFIG" 2>&1)
    if [ $? -ne 0 ]; then
      echo "Check failed: $CHECK_OUTPUT"
      rm -f "$TMP_CONFIG"
      exit 1
    fi
    cp -f "$CONFIG_PATH" "${CONFIG_PATH}.bak"
    mv -f "$TMP_CONFIG" "$CONFIG_PATH"
    chmod 644 "$CONFIG_PATH"
    "$SERVICE_SCRIPT" restart >/dev/null 2>&1 &
    echo "OK"
    ;;

  del)
    if [ -z "$2" ]; then
      echo "Error: missing node tag to delete"
      exit 1
    fi
    TAG="$2"
    TMP_CONFIG="/data/adb/box/sing-box/config.json.tmp"
    /data/adb/ksu/bin/busybox awk -v tag="$TAG" '
      BEGIN { skip=0 }
      $0 ~ ("\"tag\"[[:space:]]*:[[:space:]]*\"" tag "\"") && !skip {
        skip=1
        next
      }
      skip && /^[[:space:]]*\},?[[:space:]]*$/ {
        skip=0
        next
      }
      skip { next }
      $0 ~ ("\"" tag "\",?") { next }
      { print }
    ' "$CONFIG_PATH" > "$TMP_CONFIG"

    CHECK_OUTPUT=$("$BIN_PATH" check -D /data/adb/box/sing-box -c "$TMP_CONFIG" 2>&1)
    if [ $? -ne 0 ]; then
      echo "Check failed: $CHECK_OUTPUT"
      rm -f "$TMP_CONFIG"
      exit 1
    fi
    cp -f "$CONFIG_PATH" "${CONFIG_PATH}.bak"
    mv -f "$TMP_CONFIG" "$CONFIG_PATH"
    chmod 644 "$CONFIG_PATH"
    "$SERVICE_SCRIPT" restart >/dev/null 2>&1 &
    echo "OK"
    ;;

  status)
    PID=$(busybox pidof sing-box 2>/dev/null)
    IPV6_ADDR=$(ip -6 addr show scope global 2>/dev/null | awk '/inet6/ {print $2}' | head -n 1)

    # Auto-healing: Ensure current IPv6 is in LOCAL_IP_V6 bypass chain
    if [ -n "$IPV6_ADDR" ]; then
      CURRENT_IP_PREFIX=$(echo "$IPV6_ADDR" | cut -d/ -f1)
      if ! ip6tables -t mangle -S LOCAL_IP_V6 2>/dev/null | grep -q "$CURRENT_IP_PREFIX"; then
        ip6tables -w 100 -t mangle -I LOCAL_IP_V6 1 -d "$IPV6_ADDR" -j RETURN 2>/dev/null
        ip6tables -w 100 -t mangle -I BOX_EXTERNAL 1 -d "$IPV6_ADDR" -j RETURN 2>/dev/null
        ip6tables -w 100 -t mangle -I BOX_LOCAL 1 -d "$IPV6_ADDR" -j RETURN 2>/dev/null
      fi
    fi

    # Accurate physical resident memory (VmRSS) in MB
    MEM="0"
    if [ -n "$PID" ] && [ -f "/proc/$PID/status" ]; then
      MEM=$(awk '/VmRSS/ {print int($2/1024)}' "/proc/$PID/status" 2>/dev/null)
    fi

    GAME_BYPASS="false"
    if iptables -t mangle -S BOX_LOCAL 2>/dev/null | grep -q "10341"; then
      GAME_BYPASS="true"
    fi

    echo "{"
    echo "  \"pid\": \"$PID\","
    echo "  \"mem_mb\": \"$MEM\","
    echo "  \"has_ipv6\": $([ -n "$IPV6_ADDR" ] && echo true || echo false),"
    echo "  \"ipv6_addr\": \"$IPV6_ADDR\","
    echo "  \"game_bypass\": $GAME_BYPASS,"
    echo "  \"game_name\": \"王者荣耀 (com.tencent.tmgp.sgame)\""
    echo "}"
    ;;

  *)
    echo "Usage: $0 {get|save <base64>|restart|status}"
    exit 1
    ;;
esac
