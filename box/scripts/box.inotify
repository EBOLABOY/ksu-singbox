#!/system/bin/sh

scripts=$(realpath "$0")
scripts_dir=$(dirname "${scripts}")

source "${scripts_dir}/box.config"

service_path="${scripts_dir}/box.service"
tproxy_path="${scripts_dir}/box.tproxy"
smart_home_path="${scripts_dir}/box.smart_home.sh"

events=$1
monitor_dir=$2
monitor_file=$3

stop_smart_home() {
  local targets=""
  if [ -s "${run_path}/smart_home.pid" ] ; then
    local spid=$(cat "${run_path}/smart_home.pid" 2>/dev/null)
    if [ -n "${spid}" ] && [ -r "/proc/${spid}/cmdline" ] && tr '\0' ' ' < "/proc/${spid}/cmdline" | grep -q 'box.smart_home.sh' ; then
      targets="${spid}"
    fi
  fi
  local ps_pids=$(ps -A -o PID,ARGS 2>/dev/null | awk '$2 ~ /(^|\/)sh$/ && $3=="/data/adb/box/scripts/box.smart_home.sh" {print $1}')
  for pid in ${targets} ${ps_pids} ; do
    [ -n "${pid}" ] || continue
    kill -0 "${pid}" 2>/dev/null || continue
    local children=$(ps -A -o PID,PPID 2>/dev/null | awk -v parent="${pid}" '$2==parent {print $1}')
    [ -z "${children}" ] || kill ${children} 2>/dev/null || true
    kill "${pid}" 2>/dev/null || true
  done
}

service_control() {
  if [ ! -f "${box_path}/manual" ] ; then
    if [ "${monitor_file}" = "disable" ] ; then
      if [ "${events}" = "d" ] ; then
        "${service_path}" start >> "${run_path}/run.log" 2>> "${run_path}/run_error.log" && \
        "${tproxy_path}" enable >> "${run_path}/run.log" 2>> "${run_path}/run_error.log"
        [ -x "${smart_home_path}" ] && nohup "${smart_home_path}" >/dev/null 2>&1 < /dev/null &
      elif [ "${events}" = "n" ] ; then
        stop_smart_home
        "${tproxy_path}" disable >> "${run_path}/run.log" 2>> "${run_path}/run_error.log"
        "${service_path}" stop >> "${run_path}/run.log" 2>> "${run_path}/run_error.log"
      fi
    fi
  fi
}

mkdir -p "${run_path}"

service_control
