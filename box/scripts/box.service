#!/system/bin/sh

scripts=$(realpath $0)
scripts_dir=$(dirname ${scripts})

source ${scripts_dir}/box.config

log() {
  case "$1" in
    Info)
      echo -e "\033[32m$2\033[0m"
      ;;
    Warn)
      echo -e "\033[33m$2\033[0m"
      ;;
    Error)
      echo -e "\033[31m$2\033[0m"
      ;;
  esac
}

display() {
  local pid=$(pidof ${bin_name})
  if [ -n "${pid}" ] ; then
    log Info "${bin_name} is running. ( PID: ${pid} )"
    return 0
  else
    log Warn "${bin_name} is stopped."
    return 1
  fi
}

core_alive() {
  local pid=$(pidof ${bin_name})
  if [ -z "${pid}" ] ; then
    return 1
  fi
  if [ ! -f ${pid_file} ] ; then
    echo -n ${pid} > ${pid_file}
  fi
  return 0
}

find_netuser() {
  box_user=$(busybox id -u ${box_user_group%:*} 2>/dev/null)
  box_group=$(busybox id -g ${box_user_group#*:} 2>/dev/null)
  if [ -z "${box_user}" ] || [ -z "${box_group}" ] ; then
    box_user_group="root:net_admin"
  fi
}

check_bin() {
  if [ ! -x ${bin_path} ] ; then
    log Error "can't found ${bin_path} or no execute permission"
    return 1
  fi
  find_netuser
  return 0
}

start_service() {
  if core_alive ; then
    log Warn "${bin_name} service is running. ( PID: $(cat ${pid_file}) )"
    return 0
  fi

  if ! check_bin ; then
    return 1
  fi

  ulimit -SHn 1000000
  if ${bin_path} check -D ${box_path}/${bin_name} > ${run_path}/check.log 2>&1 ; then
    log Info "starting ${bin_name} service (low-power optimized)."
    nohup busybox setuidgid ${box_user_group} /system/bin/env GOMEMLIMIT=36MiB GOGC=30 GOMAXPROCS=2 ${bin_path} run -D ${box_path}/${bin_name} > /dev/null 2> ${run_path}/error_${bin_name}.log &
    echo -n $! > ${pid_file}
    return 0
  else
    log Error "configuration check failed, please check the ${run_path}/check.log file."
    return 1
  fi
}

stop_service() {
  if ! core_alive ; then
    log Warn "${bin_name} service is already stopped."
    return 0
  fi

  local pid=$(cat ${pid_file})
  log Info "stopping ${bin_name} service."
  kill -15 ${pid} 2>/dev/null
  sleep 1
  if kill -0 ${pid} 2>/dev/null ; then
    kill -9 ${pid} 2>/dev/null
  fi
  rm -f ${pid_file}
  return 0
}

case "$1" in
  start)
    start_service
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    sleep 1
    start_service
    ;;
  status)
    display
    ;;
  *)
    echo "$0: (start|stop|restart|status)"
    ;;
esac
