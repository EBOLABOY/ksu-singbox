#!/system/bin/sh

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH:/data/data/com.termux/files/usr/bin"

scripts=$(realpath "$0")
scripts_dir=$(dirname "${scripts}")

source "${scripts_dir}/box.config"
mark_id="16777216/16777216"
table_id="2024"
# routing_mark="233"

log() {
  export TZ=Asia/Shanghai
  now=$(date +"[%Y-%m-%d %H:%M:%S %Z]")
  case $1 in
    Info)
      [ -t 1 ] && echo -e "\033[1;32m${now} [Info]: $2\033[0m" || echo "${now} [Info]: $2"
      ;;
    Warn)
      [ -t 1 ] && echo -e "\033[1;33m${now} [Warn]: $2\033[0m" || echo "${now} [Warn]: $2"
      ;;
    Error)
      [ -t 1 ] && echo -e "\033[1;31m${now} [Error]: $2\033[0m" || echo "${now} [Error]: $2"
      ;;
    *)
      [ -t 1 ] && echo -e "\033[1;30m${now} [$1]: $2\033[0m" || echo "${now} [$1]: $2"
      ;;
  esac
}

# Defensively normalize legacy box.config values preserved across module upgrades:
# - Never match Wi-Fi STA uplink wlan0 via overly broad "wlan+"
# - Ensure RFC1918 172.16.0.0/12 is bypassed and 100.0.0.0/8 is narrowed to CGNAT 100.64.0.0/10
# - Ensure IPv6 ULA fd00::/8 is bypassed (without colliding with FakeIP fc00::/18)
effective_ap_list=()
effective_intranet=()
effective_intranet6=()

normalize_network_lists() {
  effective_ap_list=()
  if [ "${#ap_list[@]}" -gt 0 ] ; then
    local raw_ap=""
    for ap in "${ap_list[@]}" ; do
      if [ "${ap}" = "wlan+" ] ; then
        raw_ap="${raw_ap} wlan1 wlan2 wlan3"
      else
        raw_ap="${raw_ap} ${ap}"
      fi
    done
    raw_ap="${raw_ap} softap+"
    for ap in $(printf '%s\n' ${raw_ap} | awk 'NF && !seen[$0]++') ; do
      effective_ap_list[${#effective_ap_list[@]}]="${ap}"
    done
  fi

  effective_intranet=()
  local raw_v4=""
  for subnet in "${intranet[@]}" ; do
    if [ "${subnet}" = "100.0.0.0/8" ] ; then
      raw_v4="${raw_v4} 100.64.0.0/10"
    else
      raw_v4="${raw_v4} ${subnet}"
    fi
  done
  raw_v4="${raw_v4} 172.16.0.0/12"
  for subnet in $(printf '%s\n' ${raw_v4} | awk 'NF && !seen[$0]++') ; do
    effective_intranet[${#effective_intranet[@]}]="${subnet}"
  done

  effective_intranet6=()
  local raw_v6=""
  for subnet6 in "${intranet6[@]}" ; do
    raw_v6="${raw_v6} ${subnet6}"
  done
  raw_v6="${raw_v6} fd00::/8"
  for subnet6 in $(printf '%s\n' ${raw_v6} | awk 'NF && !seen[$0]++') ; do
    effective_intranet6[${#effective_intranet6[@]}]="${subnet6}"
  done
}

uid_list=()
find_packages_uid() {
  uid_list=()
  for user_package in "${user_packages_list[@]}" ; do
    user=$(echo "${user_package}" | awk -F ':' '{print $1}')
    package=$(echo "${user_package}" | awk -F ':' '{print $2}')
    uid="$(awk -v pkg="${package}" '$1 == pkg {print $2; exit}' /data/system/packages.list)"
    if [ -n "${uid}" ] ; then
      uid_list[${#uid_list[@]}]=$(expr "${user}" \* "100000" + "${uid}")
    fi
  done
}

probe_user_group() {
  if bin_pid=$(busybox pidof "${bin_name}" | awk '{print $1}') && [ -n "${bin_pid}" ] ; then
    box_user=$(stat -c %U "/proc/${bin_pid}")
    box_group=$(stat -c %G "/proc/${bin_pid}")
    return 0
  else
    box_user=$(echo "${box_user_group}" | awk -F ':' '{print $1}')
    box_group=$(echo "${box_user_group}" | awk -F ':' '{print $2}')
    return 1
  fi
}

# Locked, idempotent refresh of dynamic host IPv4 (/32) and IPv6 (/128 + on-link /64)
# addresses in LOCAL_IP_V4 / LOCAL_IP_V6. No-op when TPROXY is inactive or IPs unchanged.
sync_local_ips() {
  local force="${1:-}"
  mkdir -p "${run_path}" 2>/dev/null || true

  iptables -w 100 -t mangle -S LOCAL_IP_V4 >/dev/null 2>&1 || return 0

  local lock="${run_path}/tproxy-sync.lockdir"
  local attempts=0
  until mkdir "${lock}" 2>/dev/null ; do
    local owner=$(cat "${lock}/pid" 2>/dev/null)
    if [ -n "${owner}" ] && ! kill -0 "${owner}" 2>/dev/null ; then
      rm -f "${lock}/pid"
      rmdir "${lock}" 2>/dev/null || true
    fi
    attempts=$((attempts + 1))
    [ "${attempts}" -lt 30 ] || return 0
    sleep 0.1
  done
  echo $$ > "${lock}/pid"

  local v4_list v6_list state_file new_state old_state has_v6=0
  v4_list=$(ip -4 addr show 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); if ($2 != "" && $2 !~ /^127\./) print $2 "/32"}' | sort -u)
  if ip6tables -w 100 -t mangle -S LOCAL_IP_V6 >/dev/null 2>&1 ; then
    has_v6=1
    v6_list=$( {
      ip -6 addr show scope global 2>/dev/null | awk '/inet6 / {sub(/\/.*/, "", $2); if ($2 != "" && $2 !~ /^fe80:|^::1$|^::$/) print $2 "/128"}'
      ip -6 route show table all 2>/dev/null | awk '($0 ~ /proto kernel/ || $0 ~ /table local_network/) && $1 ~ /^[0-9a-fA-F:]+\/[0-9]+$/ && $1 !~ /^fe80:|^ff00:|^::1\/|^::\// {print $1}'
    } | sort -u )
  fi

  state_file="${run_path}/local_ips.state"
  new_state="v6en:${has_v6};v4:${v4_list};v6:${v6_list}"
  old_state=$(cat "${state_file}" 2>/dev/null)

  if [ "${force}" = "--force" ] || [ "${new_state}" != "${old_state}" ] ; then
    # Atomic update via iptables-restore --noflush (0ms gap); fall back to sequential commands if unavailable.
    if command -v iptables-restore >/dev/null 2>&1 ; then
      {
        printf '*mangle\n-F LOCAL_IP_V4\n'
        for ip4 in ${v4_list} ; do
          printf -- '-A LOCAL_IP_V4 -d %s -j RETURN\n' "${ip4}"
        done
        printf 'COMMIT\n'
      } | iptables-restore --noflush --wait=10 2>/dev/null || {
        iptables -w 100 -t mangle -F LOCAL_IP_V4 2>/dev/null || true
        for ip4 in ${v4_list} ; do
          iptables -w 100 -t mangle -A LOCAL_IP_V4 -d "${ip4}" -j RETURN 2>/dev/null || true
        done
      }
    else
      iptables -w 100 -t mangle -F LOCAL_IP_V4 2>/dev/null || true
      for ip4 in ${v4_list} ; do
        iptables -w 100 -t mangle -A LOCAL_IP_V4 -d "${ip4}" -j RETURN 2>/dev/null || true
      done
    fi

    if [ "${has_v6}" = "1" ] ; then
      if command -v ip6tables-restore >/dev/null 2>&1 ; then
        {
          printf '*mangle\n-F LOCAL_IP_V6\n'
          for ip6 in ${v6_list} ; do
            printf -- '-A LOCAL_IP_V6 -d %s -j RETURN\n' "${ip6}"
          done
          printf 'COMMIT\n'
        } | ip6tables-restore --noflush --wait=10 2>/dev/null || {
          ip6tables -w 100 -t mangle -F LOCAL_IP_V6 2>/dev/null || true
          for ip6 in ${v6_list} ; do
            ip6tables -w 100 -t mangle -A LOCAL_IP_V6 -d "${ip6}" -j RETURN 2>/dev/null || true
          done
        }
      else
        ip6tables -w 100 -t mangle -F LOCAL_IP_V6 2>/dev/null || true
        for ip6 in ${v6_list} ; do
          ip6tables -w 100 -t mangle -A LOCAL_IP_V6 -d "${ip6}" -j RETURN 2>/dev/null || true
        done
      fi
    fi

    printf '%s' "${new_state}" > "${state_file}.tmp" && mv -f "${state_file}.tmp" "${state_file}"
  fi

  rm -f "${lock}/pid"
  rmdir "${lock}" 2>/dev/null || true
  return 0
}

start_redirect() {
  ${iptables} -t nat -N BOX_EXTERNAL 2>/dev/null || true
  ${iptables} -t nat -F BOX_EXTERNAL
  ${iptables} -t nat -N BOX_LOCAL 2>/dev/null || true
  ${iptables} -t nat -F BOX_LOCAL
  ${iptables} -t nat -N LOCAL_IP_V4 2>/dev/null || true
  ${iptables} -t nat -F LOCAL_IP_V4

  if [ "${bin_name}" = "clash" ] ; then
    ${iptables} -t nat -A BOX_EXTERNAL -p udp --dport 53 -j REDIRECT --to-ports ${clash_dns_port}
    ${iptables} -t nat -A BOX_LOCAL -p udp --dport 53 -j REDIRECT --to-ports ${clash_dns_port}
    ${iptables} -t nat -A BOX_EXTERNAL -d ${fake_ip_range_v4} -p icmp -j DNAT --to-destination 127.0.0.1
    ${iptables} -t nat -A BOX_LOCAL -d ${fake_ip_range_v4} -p icmp -j DNAT --to-destination 127.0.0.1
  fi

  for subnet in "${effective_intranet[@]}" ; do
    ${iptables} -t nat -A BOX_EXTERNAL -d "${subnet}" -j RETURN
    ${iptables} -t nat -A BOX_LOCAL -d "${subnet}" -j RETURN
  done
  ${iptables} -t nat -A BOX_EXTERNAL -j LOCAL_IP_V4
  ${iptables} -t nat -A BOX_LOCAL -j LOCAL_IP_V4

  ${iptables} -t nat -A BOX_EXTERNAL -p tcp -i lo -j REDIRECT --to-ports ${redir_port}

  if [ "${#effective_ap_list[@]}" -gt 0 ] ; then
    for ap in "${effective_ap_list[@]}" ; do
      ${iptables} -t nat -A BOX_EXTERNAL -p tcp -i "${ap}" -j REDIRECT --to-ports ${redir_port}
    done
    log Info "${effective_ap_list[*]} transparent proxy."
  fi

  ${iptables} -t nat -I PREROUTING -j BOX_EXTERNAL

  ${iptables} -t nat -I BOX_LOCAL -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN

  for ap in "${effective_ap_list[@]}" ; do
    ${iptables} -t nat -A BOX_LOCAL -o "${ap}" -j RETURN
  done

  if [ "${#ignore_out_list[@]}" -gt 0 ] ; then
    for ignore in "${ignore_out_list[@]}" ; do
      ${iptables} -t nat -A BOX_LOCAL -o "${ignore}" -j RETURN
    done
    log Info "${ignore_out_list[*]} ignore transparent proxy."
  fi

  if [ "${proxy_mode}" = "blacklist" ] ; then
    for appid in "${uid_list[@]}" ; do
      ${iptables} -t nat -A BOX_LOCAL -m owner --uid-owner "${appid}" -j RETURN
    done
    for gid in "${gid_list[@]}" ; do
      ${iptables} -t nat -A BOX_LOCAL -m owner --gid-owner "${gid}" -j RETURN
    done
    ${iptables} -t nat -A BOX_LOCAL -p tcp -j REDIRECT --to-ports ${redir_port}
    if [ "${#uid_list[@]}" -eq 0 ] && [ "${#gid_list[@]}" -eq 0 ] ; then
      log Info "transparent proxy for all apps."
    else
      [ "${#uid_list[@]}" -gt 0 ] && log Info "proxy mode: ${proxy_mode}, ${user_packages_list[*]} no transparent proxy."
      [ "${#gid_list[@]}" -gt 0 ] && log Info "proxy mode: ${proxy_mode}, GID ${gid_list[*]} no transparent proxy."
    fi
  elif [ "${proxy_mode}" = "whitelist" ] ; then
    if [ "${#uid_list[@]}" -gt 0 ] ; then
      for appid in "${uid_list[@]}" ; do
        ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --uid-owner "${appid}" -j REDIRECT --to-ports ${redir_port}
      done
      ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --uid-owner 0 -j REDIRECT --to-ports ${redir_port}
      ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --uid-owner 1052 -j REDIRECT --to-ports ${redir_port}
      log Info "proxy mode: ${proxy_mode}, ${user_packages_list[*]} transparent proxy."
    fi
    if [ "${#gid_list[@]}" -gt 0 ] ; then
      for gid in "${gid_list[@]}" ; do
        ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --gid-owner "${gid}" -j REDIRECT --to-ports ${redir_port}
      done
      log Info "proxy mode: ${proxy_mode}, GID ${gid_list[*]} transparent proxy."
    fi
  else
    log Warn "proxy mode: ${proxy_mode} error."
    ${iptables} -t nat -A BOX_LOCAL -p tcp -j REDIRECT --to-ports ${redir_port}
    log Info "transparent proxy for all apps."
  fi

  ${iptables} -t nat -I OUTPUT -j BOX_LOCAL

  ${iptables} -A OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport ${redir_port} -j REJECT
}

stop_redirect() {
  while ${iptables} -t nat -D PREROUTING -j BOX_EXTERNAL 2>/dev/null ; do : ; done
  while ${iptables} -t nat -D OUTPUT -j BOX_LOCAL 2>/dev/null ; do : ; done

  while ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport ${redir_port} -j REJECT 2>/dev/null ; do : ; done
  while ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner 0 --gid-owner 3005 -m tcp --dport ${redir_port} -j REJECT 2>/dev/null ; do : ; done

  ${iptables} -t nat -F BOX_EXTERNAL 2>/dev/null || true
  ${iptables} -t nat -X BOX_EXTERNAL 2>/dev/null || true
  ${iptables} -t nat -F BOX_LOCAL 2>/dev/null || true
  ${iptables} -t nat -X BOX_LOCAL 2>/dev/null || true
  ${iptables} -t nat -F LOCAL_IP_V4 2>/dev/null || true
  ${iptables} -t nat -X LOCAL_IP_V4 2>/dev/null || true
}

start_tproxy() {
  if [ "${iptables}" = "ip6tables -w 100" ] ; then
    while ip -6 rule del fwmark ${mark_id} table ${table_id} pref ${table_id} 2>/dev/null ; do : ; done
    ip -6 rule add fwmark ${mark_id} table ${table_id} pref ${table_id} || return 1
    ip -6 route replace local default dev lo table ${table_id} || return 1
  else
    while ip rule del fwmark ${mark_id} table ${table_id} pref ${table_id} 2>/dev/null ; do : ; done
    ip rule add fwmark ${mark_id} table ${table_id} pref ${table_id} || return 1
    ip route replace local default dev lo table ${table_id} || return 1
  fi

  ${iptables} -t mangle -N DIVERT 2>/dev/null || true
  ${iptables} -t mangle -F DIVERT
  ${iptables} -t mangle -A DIVERT -j MARK --set-xmark ${mark_id}
  ${iptables} -t mangle -A DIVERT -j ACCEPT

  ${iptables} -t mangle -N BOX_EXTERNAL 2>/dev/null || true
  ${iptables} -t mangle -F BOX_EXTERNAL

  # 1. Existing transparent TCP sockets (accepted by sing-box) -> DIVERT.
  #    Note: UDP intentionally does NOT use DIVERT because sing-box binds write-only
  #    transparent UDP reply sockets to orig_dst:orig_port while reading on tproxy_port.
  ${iptables} -t mangle -A BOX_EXTERNAL -p tcp -m socket --transparent -j DIVERT
  # 2. Existing non-transparent TCP sockets (sing-box outbound, bypassed apps, adbd) -> RETURN.
  ${iptables} -t mangle -A BOX_EXTERNAL -p tcp -m socket -j RETURN

  # 3. Never hijack unmarked loopback traffic (e.g. sing-box or bypassed apps talking to local IPs).
  #    Prevents loopback self-amplification storms even during IPv6 prefix transitions.
  ${iptables} -t mangle -A BOX_EXTERNAL -i lo -m mark ! --mark ${mark_id} -j RETURN

  # 4. Route DNS (port 53) from marked local traffic and hotspot interfaces to Box
  #    BEFORE intranet bypass (hotspot/LAN DNS servers are usually RFC1918 or link-local).
  if [ "${mihome_dns_forward}" = "true" ] && [ "${bin_name}" = "mihomo" ] || [ "${bin_name}" = "hysteria" ] || [ "${bin_name}" = "clash" ] ; then
    ${iptables} -t mangle -A BOX_EXTERNAL -p tcp --dport 53 -j RETURN
    ${iptables} -t mangle -A BOX_EXTERNAL -p udp --dport 53 -j RETURN
  else
    ${iptables} -t mangle -A BOX_EXTERNAL -i lo -p tcp --dport 53 -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}
    ${iptables} -t mangle -A BOX_EXTERNAL -i lo -p udp --dport 53 -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}
    if [ "${#effective_ap_list[@]}" -gt 0 ] ; then
      for ap in "${effective_ap_list[@]}" ; do
        ${iptables} -t mangle -A BOX_EXTERNAL -i "${ap}" -p tcp --dport 53 -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}
        ${iptables} -t mangle -A BOX_EXTERNAL -i "${ap}" -p udp --dport 53 -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}
      done
    fi
  fi

  # 5. Bypass reserved/intranet ranges + dynamically maintained local interface addresses
  if [ "${iptables}" = "ip6tables -w 100" ] ; then
    for subnet6 in "${effective_intranet6[@]}" ; do
      ${iptables} -t mangle -A BOX_EXTERNAL -d "${subnet6}" -j RETURN
    done
    ${iptables} -t mangle -N LOCAL_IP_V6 2>/dev/null || true
    ${iptables} -t mangle -F LOCAL_IP_V6
    ${iptables} -t mangle -A BOX_EXTERNAL -j LOCAL_IP_V6
  else
    for subnet in "${effective_intranet[@]}" ; do
      ${iptables} -t mangle -A BOX_EXTERNAL -d "${subnet}" -j RETURN
    done
    ${iptables} -t mangle -N LOCAL_IP_V4 2>/dev/null || true
    ${iptables} -t mangle -F LOCAL_IP_V4
    ${iptables} -t mangle -A BOX_EXTERNAL -j LOCAL_IP_V4
  fi

  # 6. Intercept marked local traffic arriving on lo
  ${iptables} -t mangle -A BOX_EXTERNAL -p tcp -i lo -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}
  ${iptables} -t mangle -A BOX_EXTERNAL -p udp -i lo -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}

  # 7. Intercept hotspot/tethering downstream traffic (excludes STA uplink wlan0)
  if [ "${#effective_ap_list[@]}" -gt 0 ] ; then
    for ap in "${effective_ap_list[@]}" ; do
      ${iptables} -t mangle -A BOX_EXTERNAL -p tcp -i "${ap}" -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}
      ${iptables} -t mangle -A BOX_EXTERNAL -p udp -i "${ap}" -j TPROXY --on-port ${tproxy_port} --tproxy-mark ${mark_id}
    done
    log Info "${effective_ap_list[*]} transparent proxy."
  fi

  ${iptables} -t mangle -I PREROUTING -j BOX_EXTERNAL

  ${iptables} -t mangle -N BOX_LOCAL 2>/dev/null || true
  ${iptables} -t mangle -F BOX_LOCAL

  # 1. Bypass box itself
  ${iptables} -t mangle -A BOX_LOCAL -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN

  # 2. Bypass ALL traffic exiting through hotspot/tethering interfaces.
  #    Essential for kernel-generated TCP SYN-ACK / RST / TIME_WAIT packets to hotspot clients
  #    (especially global IPv6 and dynamic 172.16/12 IPv4), where sk_socket is NULL so -m owner fails.
  if [ "${#effective_ap_list[@]}" -gt 0 ] ; then
    for ap in "${effective_ap_list[@]}" ; do
      ${iptables} -t mangle -A BOX_LOCAL -o "${ap}" -j RETURN
    done
  fi

  # 3. Bypass explicitly ignored outbound interfaces
  if [ "${#ignore_out_list[@]}" -gt 0 ] ; then
    for ignore in "${ignore_out_list[@]}" ; do
      ${iptables} -t mangle -A BOX_LOCAL -o "${ignore}" -j RETURN
    done
    log Info "${ignore_out_list[*]} ignore transparent proxy."
  fi

  # 4. A bypassed app may still receive FakeIP from hijacked/shared DNS.
  #    Mark virtual destinations before any app bypass so connections return to sing-box.
  if [ "${bin_name}" = "sing-box" ] ; then
    if [ "${iptables}" = "ip6tables -w 100" ] ; then
      fake_range="${fake_ip_range_v6}"
    else
      fake_range="${fake_ip_range_v4}"
    fi
    if [ -n "${fake_range}" ] ; then
      ${iptables} -t mangle -A BOX_LOCAL -d "${fake_range}" -p tcp -j MARK --set-xmark ${mark_id}
      ${iptables} -t mangle -A BOX_LOCAL -d "${fake_range}" -p udp -j MARK --set-xmark ${mark_id}
      ${iptables} -t mangle -A BOX_LOCAL -d "${fake_range}" -j RETURN
    fi
  fi

  # 5. Route local DNS requests to Box
  if [ "${mihome_dns_forward}" = "true" ] && [ "${bin_name}" = "mihomo" ] || [ "${bin_name}" = "hysteria" ] || [ "${bin_name}" = "clash" ] ; then
    ${iptables} -t mangle -A BOX_LOCAL -p tcp --dport 53 -j RETURN
    ${iptables} -t mangle -A BOX_LOCAL -p udp --dport 53 -j RETURN
  else
    ${iptables} -t mangle -A BOX_LOCAL -p tcp --dport 53 -j MARK --set-xmark ${mark_id}
    ${iptables} -t mangle -A BOX_LOCAL -p udp --dport 53 -j MARK --set-xmark ${mark_id}
  fi

  # 6. Bypass reserved/intranet ranges + dynamically maintained local interface addresses
  if [ "${iptables}" = "ip6tables -w 100" ] ; then
    for subnet6 in "${effective_intranet6[@]}" ; do
      ${iptables} -t mangle -A BOX_LOCAL -d "${subnet6}" -j RETURN
    done
    ${iptables} -t mangle -A BOX_LOCAL -j LOCAL_IP_V6
  else
    for subnet in "${effective_intranet[@]}" ; do
      ${iptables} -t mangle -A BOX_LOCAL -d "${subnet}" -j RETURN
    done
    ${iptables} -t mangle -A BOX_LOCAL -j LOCAL_IP_V4
  fi

  # 7. App UID/GID selection
  if [ "${proxy_mode}" = "blacklist" ] ; then
    for appid in "${uid_list[@]}" ; do
      ${iptables} -t mangle -A BOX_LOCAL -m owner --uid-owner "${appid}" -j RETURN
    done
    for gid in "${gid_list[@]}" ; do
      ${iptables} -t mangle -A BOX_LOCAL -m owner --gid-owner "${gid}" -j RETURN
    done
    ${iptables} -t mangle -A BOX_LOCAL -p tcp -j MARK --set-xmark ${mark_id}
    ${iptables} -t mangle -A BOX_LOCAL -p udp -j MARK --set-xmark ${mark_id}
    if [ "${#uid_list[@]}" -eq 0 ] && [ "${#gid_list[@]}" -eq 0 ] ; then
      log Info "transparent proxy for all apps."
    else
      [ "${#uid_list[@]}" -gt 0 ] && log Info "proxy mode: ${proxy_mode}, ${user_packages_list[*]} no transparent proxy."
      [ "${#gid_list[@]}" -gt 0 ] && log Info "proxy mode: ${proxy_mode}, GID ${gid_list[*]} no transparent proxy."
    fi
  elif [ "${proxy_mode}" = "whitelist" ] ; then
    if [ "${#uid_list[@]}" -gt 0 ] ; then
      for appid in "${uid_list[@]}" ; do
        ${iptables} -t mangle -A BOX_LOCAL -p tcp -m owner --uid-owner "${appid}" -j MARK --set-xmark ${mark_id}
        ${iptables} -t mangle -A BOX_LOCAL -p udp -m owner --uid-owner "${appid}" -j MARK --set-xmark ${mark_id}
      done
      ${iptables} -t mangle -A BOX_LOCAL -p tcp -m owner --uid-owner 0 -j MARK --set-xmark ${mark_id}
      ${iptables} -t mangle -A BOX_LOCAL -p udp -m owner --uid-owner 0 -j MARK --set-xmark ${mark_id}
      ${iptables} -t mangle -A BOX_LOCAL -p tcp -m owner --uid-owner 1052 -j MARK --set-xmark ${mark_id}
      ${iptables} -t mangle -A BOX_LOCAL -p udp -m owner --uid-owner 1052 -j MARK --set-xmark ${mark_id}
      log Info "proxy mode: ${proxy_mode}, ${user_packages_list[*]} transparent proxy."
    fi
    if [ "${#gid_list[@]}" -gt 0 ] ; then
      for gid in "${gid_list[@]}" ; do
        ${iptables} -t mangle -A BOX_LOCAL -p tcp -m owner --gid-owner "${gid}" -j MARK --set-xmark ${mark_id}
        ${iptables} -t mangle -A BOX_LOCAL -p udp -m owner --gid-owner "${gid}" -j MARK --set-xmark ${mark_id}
      done
      log Info "proxy mode: ${proxy_mode}, GID ${gid_list[*]} transparent proxy."
    fi
  else
    log Warn "proxy mode: ${proxy_mode} error."
    ${iptables} -t mangle -A BOX_LOCAL -p tcp -j MARK --set-xmark ${mark_id}
    ${iptables} -t mangle -A BOX_LOCAL -p udp -j MARK --set-xmark ${mark_id}
    log Info "transparent proxy for all apps."
  fi

  ${iptables} -t mangle -I OUTPUT -j BOX_LOCAL

  # Block box process from directly dialing local tproxy_port to prevent loopback
  if [ "${iptables}" = "ip6tables -w 100" ] ; then
    ${iptables} -A OUTPUT -d ::1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport ${tproxy_port} -j REJECT
  else
    ${iptables} -A OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport ${tproxy_port} -j REJECT
  fi

  if [ "${iptables}" = "iptables -w 100" ] ; then
    if [ "${mihome_dns_forward}" = "true" ] && [ "${bin_name}" = "mihomo" ] || [ "${bin_name}" = "clash" ] ; then
      ${iptables} -t nat -N CLASH_DNS_EXTERNAL 2>/dev/null || true
      ${iptables} -t nat -F CLASH_DNS_EXTERNAL
      ${iptables} -t nat -A CLASH_DNS_EXTERNAL -p udp --dport 53 -j REDIRECT --to-ports ${clash_dns_port}
      ${iptables} -t nat -I PREROUTING -j CLASH_DNS_EXTERNAL

      ${iptables} -t nat -N CLASH_DNS_LOCAL 2>/dev/null || true
      ${iptables} -t nat -F CLASH_DNS_LOCAL
      ${iptables} -t nat -A CLASH_DNS_LOCAL -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN
      ${iptables} -t nat -A CLASH_DNS_LOCAL -p udp --dport 53 -j REDIRECT --to-ports ${clash_dns_port}
      ${iptables} -t nat -I OUTPUT -j CLASH_DNS_LOCAL
    fi

    # Return ICMP echo for FakeIP destinations cleanly (added once on IPv4 pass only)
    if ! iptables -w 100 -t nat -C OUTPUT -d "${fake_ip_range_v4}" -p icmp -j DNAT --to-destination 127.0.0.1 2>/dev/null ; then
      iptables -w 100 -t nat -A OUTPUT -d "${fake_ip_range_v4}" -p icmp -j DNAT --to-destination 127.0.0.1
    fi
    if ! iptables -w 100 -t nat -C PREROUTING -d "${fake_ip_range_v4}" -p icmp -j DNAT --to-destination 127.0.0.1 2>/dev/null ; then
      iptables -w 100 -t nat -A PREROUTING -d "${fake_ip_range_v4}" -p icmp -j DNAT --to-destination 127.0.0.1
    fi
  fi
  return 0
}

stop_tproxy() {
  while ip -6 rule del fwmark ${mark_id} table ${table_id} pref ${table_id} 2>/dev/null ; do : ; done
  ip -6 route flush table ${table_id} 2>/dev/null || true
  while ip rule del fwmark ${mark_id} table ${table_id} pref ${table_id} 2>/dev/null ; do : ; done
  ip route flush table ${table_id} 2>/dev/null || true

  while ${iptables} -t mangle -D PREROUTING -j BOX_EXTERNAL 2>/dev/null ; do : ; done
  while ${iptables} -t mangle -D PREROUTING -p tcp -m socket -j DIVERT 2>/dev/null ; do : ; done
  while ${iptables} -t mangle -D PREROUTING -p tcp -m socket --transparent -j DIVERT 2>/dev/null ; do : ; done
  while ${iptables} -t mangle -D OUTPUT -j BOX_LOCAL 2>/dev/null ; do : ; done

  ${iptables} -t mangle -F BOX_EXTERNAL 2>/dev/null || true
  ${iptables} -t mangle -X BOX_EXTERNAL 2>/dev/null || true

  ${iptables} -t mangle -F BOX_LOCAL 2>/dev/null || true
  ${iptables} -t mangle -X BOX_LOCAL 2>/dev/null || true

  iptables -w 100 -t mangle -F LOCAL_IP_V4 2>/dev/null || true
  iptables -w 100 -t mangle -X LOCAL_IP_V4 2>/dev/null || true
  ip6tables -w 100 -t mangle -F LOCAL_IP_V6 2>/dev/null || true
  ip6tables -w 100 -t mangle -X LOCAL_IP_V6 2>/dev/null || true

  ${iptables} -t mangle -F DIVERT 2>/dev/null || true
  ${iptables} -t mangle -X DIVERT 2>/dev/null || true

  if [ "${iptables}" = "ip6tables -w 100" ] ; then
    while ${iptables} -D OUTPUT -d ::1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport ${tproxy_port} -j REJECT 2>/dev/null ; do : ; done
    while ${iptables} -D OUTPUT -d ::1 -p tcp -m owner --uid-owner 0 --gid-owner 3005 -m tcp --dport ${tproxy_port} -j REJECT 2>/dev/null ; do : ; done
  else
    while ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport ${tproxy_port} -j REJECT 2>/dev/null ; do : ; done
    while ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner 0 --gid-owner 3005 -m tcp --dport ${tproxy_port} -j REJECT 2>/dev/null ; do : ; done
  fi

  local nat_ipt="iptables -w 100"
  while ${nat_ipt} -t nat -D PREROUTING -j CLASH_DNS_EXTERNAL 2>/dev/null ; do : ; done
  while ${nat_ipt} -t nat -D OUTPUT -j CLASH_DNS_LOCAL 2>/dev/null ; do : ; done

  ${nat_ipt} -t nat -F CLASH_DNS_EXTERNAL 2>/dev/null || true
  ${nat_ipt} -t nat -X CLASH_DNS_EXTERNAL 2>/dev/null || true

  ${nat_ipt} -t nat -F CLASH_DNS_LOCAL 2>/dev/null || true
  ${nat_ipt} -t nat -X CLASH_DNS_LOCAL 2>/dev/null || true

  while ${nat_ipt} -t nat -D OUTPUT -d "${fake_ip_range_v4}" -p icmp -j DNAT --to-destination 127.0.0.1 2>/dev/null ; do : ; done
  while ${nat_ipt} -t nat -D PREROUTING -d "${fake_ip_range_v4}" -p icmp -j DNAT --to-destination 127.0.0.1 2>/dev/null ; do : ; done

  rm -f "${run_path}/local_ips.state" "${run_path}/local_ips.state.tmp"
}

disable_ipv6() {
  echo 0 > /proc/sys/net/ipv6/conf/all/accept_ra
  [ -w /proc/sys/net/ipv6/conf/wlan0/accept_ra ] && echo 0 > /proc/sys/net/ipv6/conf/wlan0/accept_ra
  echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
  echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
  [ -w /proc/sys/net/ipv6/conf/wlan0/disable_ipv6 ] && echo 1 > /proc/sys/net/ipv6/conf/wlan0/disable_ipv6
}

enable_ipv6() {
  # Android requires accept_ra=2 so Router Advertisements continue to be accepted
  # when hotspot/tethering enables net.ipv6.conf.all.forwarding=1.
  echo 2 > /proc/sys/net/ipv6/conf/all/accept_ra
  echo 2 > /proc/sys/net/ipv6/conf/default/accept_ra
  [ -w /proc/sys/net/ipv6/conf/wlan0/accept_ra ] && echo 2 > /proc/sys/net/ipv6/conf/wlan0/accept_ra
  echo 0 > /proc/sys/net/ipv6/conf/all/disable_ipv6
  echo 0 > /proc/sys/net/ipv6/conf/default/disable_ipv6
  [ -w /proc/sys/net/ipv6/conf/wlan0/disable_ipv6 ] && echo 0 > /proc/sys/net/ipv6/conf/wlan0/disable_ipv6
}

apply_rules() {
  if ! probe_user_group ; then
    log Error "failed to check Box user group, please make sure ${bin_name} core is started."
    return 1
  fi
  normalize_network_lists
  find_packages_uid
  if [ "${proxy_method}" = "TPROXY" ] ; then
    if (zcat /proc/config.gz 2>/dev/null | grep -q TPROXY) || grep -qw TPROXY /proc/net/ip_tables_targets 2>/dev/null ; then
      log Info "use TPROXY:TCP+UDP."
      log Info "creating ip(6)tables transparent proxy rules."
      iptables="iptables -w 100"
      start_tproxy && log Info "create iptables transparent proxy rules done." || { log Error "create iptables transparent proxy rules failed."; stop_tproxy >> /dev/null 2>&1; return 1; }
      if [ "${ipv6}" = "enable" ] ; then
        log Debug "use IPv6."
        enable_ipv6
        iptables="ip6tables -w 100"
        start_tproxy && log Info "create ip6tables transparent proxy rules done." || { log Error "create ip6tables transparent proxy rules failed."; stop_tproxy >> /dev/null 2>&1; return 1; }
      else
        disable_ipv6
        log Warn "disable IPv6."
      fi
      sync_local_ips --force
    else
      log Warn "the device does not support TPROXY, please switch proxy_method."
      log Info "use REDIRECT:TCP."
      log Info "creating iptables transparent proxy rules."
      iptables="iptables -w 100"
      start_redirect && log Info "create iptables transparent proxy rules done." || { log Error "create iptables transparent proxy rules failed."; stop_redirect >> /dev/null 2>&1; return 1; }
      [ "${ipv6}" = "enable" ] && enable_ipv6 && log Warn "enable IPv6." || { disable_ipv6; log Warn "disable IPv6."; }
    fi
  else
    [ "${proxy_method}" = "REDIRECT" ] && log Info "use REDIRECT:TCP." || log Info "use MIXED:TCP+TUN."
    log Info "creating iptables transparent proxy rules."
    iptables="iptables -w 100"
    start_redirect && log Info "create iptables transparent proxy rules done." || { log Error "create iptables transparent proxy rules failed."; stop_redirect >> /dev/null 2>&1; return 1; }
    [ "${ipv6}" = "enable" ] && enable_ipv6 && log Warn "enable IPv6." || { disable_ipv6; log Warn "disable IPv6."; }
  fi
  return 0
}

if [ "${proxy_mode}" = "core" ] ; then
  probe_user_group
  iptables="iptables -w 100" && stop_tproxy >> /dev/null 2>&1
  iptables="ip6tables -w 100" && stop_tproxy >> /dev/null 2>&1
  iptables="iptables -w 100" && stop_redirect >> /dev/null 2>&1
  log Info "proxy_mode: ${proxy_mode}, disable transparent proxy."
  exit 0
fi

case "$1" in
  enable)
    probe_user_group
    iptables="iptables -w 100" && stop_tproxy >> /dev/null 2>&1
    iptables="ip6tables -w 100" && stop_tproxy >> /dev/null 2>&1
    iptables="iptables -w 100" && stop_redirect >> /dev/null 2>&1
    sleep 1
    apply_rules
    ;;
  disable)
    log Warn "cleaning up ip(6)tables transparent proxy rules."
    probe_user_group
    iptables="iptables -w 100" && stop_tproxy >> /dev/null 2>&1
    iptables="ip6tables -w 100" && stop_tproxy >> /dev/null 2>&1
    iptables="iptables -w 100" && stop_redirect >> /dev/null 2>&1
    log Warn "clean up ip(6)tables transparent proxy rules done."
    enable_ipv6
    log Warn "enable IPv6."
    exit 0
    ;;
  renew)
    log Warn "cleaning up ip(6)tables transparent proxy rules."
    probe_user_group
    iptables="iptables -w 100" && stop_tproxy >> /dev/null 2>&1
    iptables="ip6tables -w 100" && stop_tproxy >> /dev/null 2>&1
    iptables="iptables -w 100" && stop_redirect >> /dev/null 2>&1
    log Warn "clean up ip(6)tables transparent proxy rules done."
    sleep 1
    apply_rules
    ;;
  sync-ips)
    sync_local_ips "$2"
    ;;
  enable_ipv6)
    enable_ipv6
    log Warn "enable IPv6."
    ;;
  disable_ipv6)
    disable_ipv6
    log Warn "disable IPv6."
    ;;
  *)
    log Error "$0 $1 usage: $0 {enable|disable|renew|sync-ips|enable_ipv6|disable_ipv6}"
    ;;
esac
